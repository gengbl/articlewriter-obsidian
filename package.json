{
	"name": "articlewriter-obsidian",
	"version": "1.0.0",
	"description": "AI novel writing tool as an Obsidian plugin (file/folder create, open, save)",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs --production",
		"lint": "eslint src/"
	},
	"keywords": [
		"obsidian",
		"novel",
		"writing"
	],
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^18.19.0",
		"esbuild": "0.25.0",
		"eslint": "^10.12.0",
		"obsidian": "latest",
		"tslib": "2.6.2",
		"typescript": "5.4.5",
		"typescript-eslint": "^8.71.2"
	},
	"dependencies": {
		"openai": "^7.8.0",
		"yaml": "^2.9.0"
	},
	"allowScripts": {
		"esbuild@0.25.0": true
	}
}
