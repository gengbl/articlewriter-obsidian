{
	"name": "articlewriter-obsidian",
	"version": "1.0.0",
	"description": "AI novel writing tool as an Obsidian plugin (file/folder create, open, save)",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs --production"
	},
	"keywords": [
		"obsidian",
		"novel",
		"writing"
	],
	"license": "MIT",
	"devDependencies": {
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^18.19.0",
		"builtin-modules": "^3.3.0",
		"esbuild": "0.25.0",
		"obsidian": "latest",
		"tslib": "2.6.2",
		"typescript": "5.4.5"
	},
	"dependencies": {
		"js-yaml": "^5.4.1",
		"openai": "^7.8.0"
	}
}
